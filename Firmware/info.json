{
    "keyboard_name": "Evapad",
    "manufacturer": "HackClubber",
    "maintainer": "yahoo",
    "development_board": "promicro_rp2040",
    "bootloader": "rp2040",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true
    },
    "matrix_pins": {
        "direct": [
            ["GP4", "GP2", "GP3", "GP7"]
        ]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP9", "pin_b": "GP8"}
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 0, "y": 1},
                {"matrix": [0, 3], "x": 1, "y": 1}
            ]
        }
    }
}